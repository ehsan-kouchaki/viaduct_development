<?xml version="1.0"?>
<launch>
    <param name="use_sim_time" value="false" />
    
    <!-- <include file="$(find gps_odometry)/launch/gps_odometry.launch" /> -->

    <node pkg="viaduct_position" type="direct_hough" name="lidar_localization" output="screen">
   	    <rosparam file= "$(find viaduct_position)/config/hough.yaml" command="load" /> 
    </node> 

    <node pkg="track_vo" type="track_piloting" name="track_piloting" output="screen">
        <rosparam file= "$(find track_vo)/config/camera.yaml" command="load" /> 
    </node> 

    <node pkg="track_vo" type="IMU_orientation" name="imu_orientation" output="screen" >
        <rosparam file= "$(find track_vo)/config/imu.yaml" command="load" />
    </node>

    <node pkg="mission_manager" type="mission_manager" name="mission_manager_localization" output="screen" >
        <rosparam file= "$(find mission_manager)/config/params.yaml" command="load" />
    </node>

    <node pkg="viaduct_position" type="ground_truth" name="ground_truth" output="screen">
        <param name="XY" value="5"/> 
        <param name="XZ" value="0"/>  
        <param name="path_topic" value="/viaddrone_position_path"/> 
    </node>

    <node pkg="viaduct_position" type="3dPointCloud" name="name" output="screen"/>
    
    <include file="$(find viaduct_localization)/launch/viaduct_kf_localization_verde.launch"/>

    <node pkg="rviz" type="rviz" name="rviz"
        args="-d $(find viaduct_localization)/rviz/default_Alora.rviz"/> 
</launch>
