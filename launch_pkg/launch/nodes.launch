<?xml version="1.0"?>
<launch>
    <param name="use_sim_time" value="false" />
    
    <include file="$(find viaduct_position)/launch/navegation.launch"/>

    <include file="$(find viaduct_localization)/launch/viaduct_kf_localization.launch"/>

    <node pkg="rviz" type="rviz" name="rviz"
        args="-d $(find viaduct_localization)/rviz/default.rviz"/> 
</launch>
