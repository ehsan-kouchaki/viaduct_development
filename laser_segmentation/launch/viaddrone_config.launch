<?xml version="1.0"?>

<launch>
  <master auto="start"/>

  <node pkg="rviz" type="rviz" name="rviz"
    args="-d $(find laser_segmentation)/rviz/cloud.rviz"/> deteccion_pilar hough ICP

  <node pkg="rviz" type="rviz" name="rviz2"
    args="-d $(find laser_segmentation)/rviz/path.rviz"/> deteccion_pilar hough ICP

  <node pkg="laser_segmentation" type="laser_generic" name="laser_generic" output="screen">
   	<rosparam file= "$(find laser_segmentation)/config/laser.yaml" command="load" /> 
  </node> 

  <node pkg="laser_segmentation" type="ground_truth" name="ground_truth" output="screen">
    <param name="XY" value="132"/> 
		<param name="XZ" value="0"/>  
    <param name="path_topic" value="/laser/path"/> 
  </node>

  <node pkg="laser_segmentation" type="3dPointCloud" name="pointcloud" output="screen"/>

  <!--node pkg="rosbag" type="play" name="play"
    args="$(find pruebas)/bag/alcala/scan3.bag  "/--> 

</launch>