<launch>

    <!-- Launch the T265 driver -->
    <include file="$(find aruco_detector)/launch/t265.launch"/>

    <!-- Launch the ArUco detector -->
    <node pkg="aruco_detector"
          type="aruco_detector.py"
          name="aruco_detector"
          output="screen">

        <rosparam command="load"
                  file="$(find aruco_detector)/config/detector.yaml"/>

        <param name="image_topic" value="/camera_t265/camera/fisheye1/image_raw"/>
	<param name="camera_info_topic" value="/camera_t265/camera/fisheye1/camera_info"/>
        <param name="camera_frame" value="camera_fisheye1_optical_frame"/>

    </node>

</launch>
