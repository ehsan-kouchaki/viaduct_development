<!--
-->
<launch>
	<!--param name="use_sim_time" value="true" /-->

       <include file="$(find odom_alt_correction)/launch/robot_global_localization_camera.launch"/>

       <node pkg="gps_odometry" 
              type="gps_odom_mavros_timer_orientation_covariance"
              name="gps_odom_mavros_timer_orientation_covariance"
              output="screen">
            <param name="gpsTopic"                      value="/gps/global"/>
	    <param name="gps_frame_id"                  value="/map"/>
	    <param name="angle_to_north"                value="55.557670"/> <!-- -67.648640 247.3379 55.557670-->
	    <param name="offset"                        value="0.0"/> <!-- 0.588 -->
	    <param name="frame_rate"                	value="30"/> 
	    <param name="out_pose_topic"                value="/mavros/vision_pose/pose"/> 
            <param name="odom_topic_or"                 value="/camera_global_localization"/>
        </node>

</launch>
