<!--
-->
<launch>
	<param name="use_sim_time" value="true" />

        <node pkg="gps_odometry" 
		      type="gps_odometry" 
			  name="gps_odometry" 
			  output="screen">
            <param name="gpsTopic" 				value="/mavros/global_position/raw/fix"/>
	    	<param name="gps_frame_id" 			value="/map"/>
	    	<param name="gps_child_frame_id" 	value="/px4_frame"/>
	    	<param name="angle_to_north" 		value="0.0" />
	    	<param name="offset" 				value="0.0" />
        </node>

        <node pkg="gps_odometry" 
              type="gps_angle_estimation" 
              name="gps_angle_estimation" 
              output="screen" 
              required="true">
            <param name="gps_odom_Topic" value="/gps/odom"/>
        </node>

        <node pkg="gps_odometry" type="gps_path" name="gps_path" output="screen"/>

</launch>
