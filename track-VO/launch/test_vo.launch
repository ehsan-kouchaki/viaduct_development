<launch>
    <arg name="sf11_serial_port" default="/dev/ttySF11"/> 

    <include file="$(find realsense2_camera)/launch/rs_camera.launch" />

    <node name="sf11_driver" 
          pkg="sf11_driver" 
          type="sf11_driver_node" 
          output="screen">
        <param name="serial_path" type="string" value="$(arg sf11_serial_port)"/> 
    </node>

    <node pkg="track_vo" type="track_piloting" name="track_piloting" output="screen" >
        <rosparam file="$(find track_vo)/config/camera.yaml" command="load" />
    </node>

    <node pkg="rviz" type="rviz" name="rviz"
        args="-d $(find track_vo)/rviz/track.rviz"/> 
</launch>