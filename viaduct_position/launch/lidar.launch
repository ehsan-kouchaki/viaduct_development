<?xml version="1.0"?>

<launch>
  <master auto="start"/>

  <node pkg="rviz" type="rviz" name="rviz"
    args="-d $(find viaduct_position)/rviz/hough.rviz"/> deteccion_pilar hough ICP

  <node pkg="rviz" type="rviz" name="rviz2"
    args="-d $(find viaduct_position)/rviz/deteccion_pilar.rviz"/> deteccion_pilar hough ICP

  <node pkg="viaduct_position" type="direct_hough" name="lidar_localization" output="screen">
   	<rosparam file= "$(find viaduct_position)/config/hough.yaml" command="load" /> 
  </node> 

  <node pkg="viaduct_position" type="ground_truth" name="ground_truth" output="screen">
    <param name="XY" value="140"/> 
		<param name="XZ" value="0"/>  
    <param name="path_topic" value="/hough/path"/> 
  </node>

  <node pkg="viaduct_position" type="3dPointCloud" name="name" output="screen"/>

  <!--node pkg="rosbag" type="play" name="play"
    args="$(find pruebas)/bag/alcala/scan3.bag  "/-->  --start 45 --duration 29 --start 58 --duration 20
--start 45 --duration 29 --clock
args="$(find pruebas)/bag/alcala/scan3.bag --clock --start 45 --duration 29
args="$(find pruebas)/bag/alcala/scan2.bag --clock --start 35 --duration 100
</launch>